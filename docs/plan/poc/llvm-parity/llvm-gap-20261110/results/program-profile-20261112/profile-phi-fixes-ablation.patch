+//! Nested error merges acquire equal tag bits only when S enums become L scalars.
+use kfrc_body::{
+    AggregateLayout, EnumLayout, FieldLayout, FunctionAbi, IntegerWidth, PassMode, RecordedTypes,
+    SizeAlign, TagEncoding, TyId, TypeShape,
+};
+use kfrc_son::{
+    CallTarget, FunctionGraph, GraphLevel, InterpretError, Interpreter, NodeId, Opcode, Outcome,
+    SemanticOutcome, Value, ValueType, lower_layout, optimize_specialized_graph, verify_graph,
+};
+
+#[derive(Clone, Copy)]
+enum Case {
+    Errors,
+    Mixed,
+    Poison,
+}
+
+#[derive(Clone, Copy)]
+struct Edge {
+    control: NodeId,
+    effect: NodeId,
+    value: NodeId,
+}
+
+struct Fixture {
+    graph: FunctionGraph,
+    word: TyId,
+    result: TyId,
+    leaf: u32,
+}
+
+fn project(graph: &mut FunctionGraph, source: NodeId, slot: u32, ty: ValueType) -> NodeId {
+    graph.add_node(Opcode::Projection, NodeId::NONE, &[source], slot, ty)
+}
+
+impl Fixture {
+    fn branch(&mut self, control: NodeId, condition: NodeId) -> [NodeId; 2] {
+        let branch = self.graph.add_node(
+            Opcode::If,
+            control,
+            &[condition],
+            0,
+            ValueType::Tuple(vec![ValueType::Control; 2]),
+        );
+        [0, 1].map(|slot| project(&mut self.graph, branch, slot, ValueType::Control))
+    }
+
+    fn call(&mut self, control: NodeId, effect: NodeId, target: u32, arguments: &[NodeId]) -> Edge {
+        let mut inputs = vec![effect];
+        inputs.extend_from_slice(arguments);
+        let call = self.graph.add_node(
+            Opcode::Call,
+            control,
+            &inputs,
+            target,
+            ValueType::Tuple(vec![
+                ValueType::Control,
+                ValueType::Effect,
+                ValueType::Rust(self.word),
+            ]),
+        );
+        Edge {
+            control: project(&mut self.graph, call, 0, ValueType::Control),
+            effect: project(&mut self.graph, call, 1, ValueType::Effect),
+            value: project(&mut self.graph, call, 2, ValueType::Rust(self.word)),
+        }
+    }
+
+    fn leaf(
+        &mut self,
+        control: NodeId,
+        effect: NodeId,
+        input: NodeId,
+        event: u128,
+        case: Case,
+    ) -> Edge {
+        let event_value = self.graph.add_constant(event, self.word);
+        let edge = self.call(control, effect, self.leaf, &[event_value, input]);
+        if matches!(case, Case::Poison) && event == 2 {
+            let poison = self.graph.add_node(
+                Opcode::Undefined,
+                NodeId::NONE,
+                &[],
+                0,
+                ValueType::Rust(self.word),
+            );
+            let three = self.graph.add_constant(3, self.word);
+            // Its unused result does not remove this fixed poison observation.
+            self.graph.add_node(
+                Opcode::DivUnsigned,
+                edge.control,
+                &[poison, three],
+                0,
+                ValueType::Rust(self.word),
+            );
+        }
+        let success = event == 0 || matches!(case, Case::Mixed) && event == 2;
+        let fields = if success { vec![] } else { vec![edge.value] };
+        let value = self.graph.add_node(
+            Opcode::MakeVariant,
+            NodeId::NONE,
+            &fields,
+            u32::from(!success),
+            ValueType::Rust(self.result),
+        );
+        Edge { value, ..edge }
+    }
+
+    fn merge(&mut self, mut edges: [Edge; 2], reverse: bool) -> Edge {
+        if reverse {
+            edges.reverse();
+        }
+        let jumps = edges.map(|edge| {
+            self.graph
+                .add_node(Opcode::Jump, edge.control, &[], 0, ValueType::Control)
+        });
+        let region =
+            self.graph
+                .add_node(Opcode::Region, NodeId::NONE, &jumps, 0, ValueType::Control);
+        let effect = self.graph.add_node(
+            Opcode::Phi,
+            NodeId::NONE,
+            &[region, edges[0].effect, edges[1].effect],
+            0,
+            ValueType::Effect,
+        );
+        let value = self.graph.add_node(
+            Opcode::Phi,
+            NodeId::NONE,
+            &[region, edges[0].value, edges[1].value],
+            0,
+            ValueType::Rust(self.result),
+        );
+        Edge {
+            control: region,
+            effect,
+            value,
+        }
+    }
+}
+
+fn source(case: Case, reverse: bool) -> FunctionGraph {
+    let mut types = RecordedTypes::new();
+    let mut integer = |width, size| {
+        types.intern(
+            TypeShape::Int {
+                width,
+                signed: false,
+            },
+            Some(SizeAlign { size, align: size }),
+        )
+    };
+    let word = integer(IntegerWidth::W64, 8);
+    let tag = integer(IntegerWidth::W8, 1);
+    let boolean = types.intern(TypeShape::Bool, Some(SizeAlign { size: 1, align: 1 }));
+    let result = types.intern(
+        TypeShape::Adt {
+            name: "DecodeResult".into(),
+        },
+        Some(SizeAlign { size: 16, align: 8 }),
+    );
+    types.record_aggregate(
+        result,
+        AggregateLayout {
+            fields: vec![],
+            variants: vec![
+                vec![],
+                vec![FieldLayout {
+                    ty: word,
+                    offset: 8,
+                }],
+            ],
+        },
+    );
+    types.record_semantic_enum(result, vec![0, 1]);
+    types.enums.insert(
+        result,
+        EnumLayout {
+            tag: Some(FieldLayout { ty: tag, offset: 0 }),
+            encoding: TagEncoding::Direct {
+                discriminants: vec![0, 1],
+            },
+        },
+    );
+    let mut graph = FunctionGraph::new(
+        "nested_error_tags",
+        FunctionAbi {
+            args: vec![PassMode::Direct; 4],
+            ret: PassMode::Direct,
+            c_variadic: false,
+        },
+        types,
+    );
+    graph.level = GraphLevel::Specialized;
+    graph.start = graph.add_node(
+        Opcode::Start,
+        NodeId::NONE,
+        &[],
+        0,
+        ValueType::Tuple(vec![
+            ValueType::Control,
+            ValueType::Effect,
+            ValueType::Rust(boolean),
+            ValueType::Rust(boolean),
+            ValueType::Rust(boolean),
+            ValueType::Rust(word),
+        ]),
+    );
+    let start = graph.start;
+    let control = project(&mut graph, start, 0, ValueType::Control);
+    let effect = project(&mut graph, start, 1, ValueType::Effect);
+    let selectors =
+        [2, 3, 4].map(|slot| project(&mut graph, start, slot, ValueType::Rust(boolean)));
+    let input = project(&mut graph, start, 5, ValueType::Rust(word));
+    let mut target = |name: &str, arguments| {
+        graph.add_callee(CallTarget {
+            symbol: name.into(),
+            abi: FunctionAbi {
+                args: vec![PassMode::Direct; arguments],
+                ret: PassMode::Direct,
+                c_variadic: false,
+            },
+        })
+    };
+    let leaf = target("tag_leaf", 2);
+    let consume = target("tag_consume", 1);
+    let mut f = Fixture {
+        graph,
+        word,
+        result,
+        leaf,
+    };
+    let [success, error] = f.branch(control, selectors[0]);
+    let success = f.leaf(success, effect, input, 0, case);
+    let [first, rest] = f.branch(error, selectors[1]);
+    let first = f.leaf(first, effect, input, 1, case);
+    let [second, third] = f.branch(rest, selectors[2]);
+    let second = f.leaf(second, effect, input, 2, case);
+    let third = f.leaf(third, effect, input, 3, case);
+    // Distinct constructors produce distinct equal-bit tag constants in L.
+    // Observable leaf calls keep both error-selection diamonds meaningful.
+    let rest = f.merge([second, third], reverse);
+    let errors = f.merge([first, rest], reverse);
+    let joined = f.merge([success, errors], reverse);
+    f.graph.variant_switches.push(vec![0, 1]);
+    let switch = f.graph.add_node(
+        Opcode::VariantSwitch,
+        joined.control,
+        &[joined.value],
+        0,
+        ValueType::Tuple(vec![ValueType::Control; 3]),
+    );
+    let yes = project(&mut f.graph, switch, 0, ValueType::Control);
+    let no = project(&mut f.graph, switch, 1, ValueType::Control);
+    let default = project(&mut f.graph, switch, 2, ValueType::Control);
+    let witness = f.graph.add_node(
+        Opcode::VariantWitness,
+        no,
+        &[joined.value, no],
+        1,
+        ValueType::Witness,
+    );
+    let field = f.graph.intern_variant_field(1, 0);
+    let payload = f.graph.add_node(
+        Opcode::VariantField,
+        NodeId::NONE,
+        &[joined.value, witness],
+        field,
+        ValueType::Rust(word),
+    );
+    let consumed = f.call(no, joined.effect, consume, &[payload]);
+    let answer = f.graph.add_constant(77, word);
+    f.graph.add_node(
+        Opcode::Return,
+        yes,
+        &[joined.effect, answer],
+        0,
+        ValueType::Control,
+    );
+    f.graph.add_node(
+        Opcode::Return,
+        consumed.control,
+        &[consumed.effect, consumed.value],
+        0,
+        ValueType::Control,
+    );
+    f.graph
+        .add_node(Opcode::Unreachable, default, &[], 0, ValueType::Control);
+    verify_graph(&mut f.graph).unwrap();
+    optimize_specialized_graph(&mut f.graph).unwrap();
+    verify_graph(&mut f.graph).unwrap();
+    f.graph
+}
+
+fn count(graph: &FunctionGraph, op: Opcode) -> usize {
+    graph.ids().filter(|&node| graph.op(node) == op).count()
+}
+
+fn lower(source: &FunctionGraph) -> FunctionGraph {
+    let mut graph = source.clone();
+    lower_layout(&mut graph).unwrap();
+    verify_graph(&mut graph).unwrap();
+    graph
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum Event {
+    Leaf(u64, u64),
+    Consume(u64),
+}
+
+fn respond(symbol: &str, arguments: &[u64], events: &mut Vec<Event>) -> u64 {
+    match (symbol, arguments) {
+        ("tag_leaf", &[event, input]) => {
+            events.push(Event::Leaf(event, input));
+            input.wrapping_add(event)
+        }
+        ("tag_consume", &[payload]) => {
+            events.push(Event::Consume(payload));
+            payload
+        }
+        other => panic!("unexpected call: {other:?}"),
+    }
+}
+
+fn compare(source: &FunctionGraph, target: &FunctionGraph, case: Case) {
+    for success in [0, 1] {
+        for first in [0, 1] {
+            for second in [0, 1] {
+                for input in [0, 17, u64::MAX] {
+                    let arguments = [success, first, second, input];
+                    let values = arguments.map(Value::Scalar);
+                    let mut before_events = vec![];
+                    let before = Interpreter::new(source)
+                        .run_values(&values, &mut |name: &str, args: &[Value]| {
+                            let args: Vec<_> = args
+                                .iter()
+                                .map(|arg| match arg {
+                                    Value::Scalar(bits) => *bits,
+                                    other => panic!("scalar argument expected: {other:?}"),
+                                })
+                                .collect();
+                            Ok(Value::Scalar(respond(name, &args, &mut before_events)))
+                        })
+                        .map(|outcome| match outcome {
+                            SemanticOutcome::Return(Value::Scalar(bits)) => bits,
+                            other => panic!("scalar return expected: {other:?}"),
+                        });
+                    let mut after_events = vec![];
+                    let after = Interpreter::new(target)
+                        .run(&arguments, &mut |name: &str, args: &[u64]| {
+                            Ok(respond(name, args, &mut after_events))
+                        })
+                        .map(|outcome| match outcome {
+                            Outcome::Return(bits) => bits,
+                            other => panic!("scalar return expected: {other:?}"),
+                        });
+                    let leaf = if success != 0 {
+                        0
+                    } else if first != 0 {
+                        1
+                    } else if second != 0 {
+                        2
+                    } else {
+                        3
+                    };
+                    let mut expected_events = vec![Event::Leaf(leaf, input)];
+                    if matches!(case, Case::Poison) && leaf == 2 {
+                        assert!(matches!(before, Err(InterpretError::PoisonObserved(_))));
+                        assert!(matches!(after, Err(InterpretError::PoisonObserved(_))));
+                    } else {
+                        let answer = if leaf == 0 || matches!(case, Case::Mixed) && leaf == 2 {
+                            77
+                        } else {
+                            let payload = input.wrapping_add(leaf);
+                            expected_events.push(Event::Consume(payload));
+                            payload
+                        };
+                        assert_eq!(before.unwrap(), answer, "source {arguments:?}");
+                        assert_eq!(after.unwrap(), answer, "layout {arguments:?}");
+                    }
+                    assert_eq!(before_events, expected_events, "source {arguments:?}");
+                    assert_eq!(after_events, expected_events, "layout {arguments:?}");
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn nested_errors_do_not_retest_tags_or_merge_inactive_success_payloads() {
+    for reverse in [false, true] {
+        let source = source(Case::Errors, reverse);
+        assert_eq!(count(&source, Opcode::If), 3);
+        assert_eq!(count(&source, Opcode::VariantSwitch), 1);
+        let target = lower(&source);
+        compare(&source, &target, Case::Errors);
+        assert_eq!(count(&target, Opcode::If), 3, "{}", target.dump());
+        assert!(
+            !target.ids().any(|node| {
+                target.op(node) == Opcode::Phi
+                    && target.inputs(node)[1..]
+                        .iter()
+                        .any(|&input| target.op(input) == Opcode::Undefined)
+            }),
+            "an error payload still merges the inactive success arm: {}",
+            target.dump()
+        );
+    }
+}
+
+#[test]
+fn a_success_among_nested_errors_keeps_its_real_dispatch() {
+    for reverse in [false, true] {
+        let source = source(Case::Mixed, reverse);
+        let target = lower(&source);
+        compare(&source, &target, Case::Mixed);
+    }
+}
+
+#[test]
+fn constant_error_tags_do_not_bypass_a_fixed_poison_observation() {
+    for reverse in [false, true] {
+        let source = source(Case::Poison, reverse);
+        let target = lower(&source);
+        assert_eq!(count(&target, Opcode::DivUnsigned), 1);
+        compare(&source, &target, Case::Poison);
+    }
+}
