+//! Register-sized enum Phis retain scalar lanes until the return ABI boundary.
+use kfrc_body::{
+    AggregateLayout, EnumLayout, FieldLayout, FunctionAbi, IntegerWidth, PassMode, RecordedTypes,
+    SizeAlign, TagEncoding, TyId, TypeShape,
+};
+use kfrc_son::{
+    ComparePredicate, FunctionGraph, GraphLevel, InterpretError, Interpreter, LayoutStats, NodeId,
+    Opcode, Outcome, SemanticOutcome, Value, ValueType, lower_layout, verify_graph,
+};
+
+fn integer(types: &mut RecordedTypes, width: IntegerWidth, bytes: u64) -> TyId {
+    types.intern(
+        TypeShape::Int {
+            width,
+            signed: false,
+        },
+        Some(SizeAlign {
+            size: bytes,
+            align: bytes,
+        }),
+    )
+}
+
+fn enumeration(
+    types: &mut RecordedTypes,
+    tag: FieldLayout,
+    payload: FieldLayout,
+    layout: SizeAlign,
+    discriminants: &[u128],
+    empty_first: bool,
+) -> TyId {
+    let ty = types.intern(
+        TypeShape::Adt {
+            name: "RegisterPhiChoice".into(),
+        },
+        Some(layout),
+    );
+    types.record_aggregate(
+        ty,
+        AggregateLayout {
+            fields: vec![],
+            variants: (0..discriminants.len())
+                .map(|index| {
+                    if empty_first && index == 0 {
+                        vec![]
+                    } else {
+                        vec![payload]
+                    }
+                })
+                .collect(),
+        },
+    );
+    types.record_semantic_enum(ty, discriminants.to_vec());
+    types.enums.insert(
+        ty,
+        EnumLayout {
+            tag: Some(tag),
+            encoding: TagEncoding::Direct {
+                discriminants: discriminants.to_vec(),
+            },
+        },
+    );
+    // The producer's ScalarPair classification is independent of byte size:
+    // two u32 lanes occupy one eight-byte storage word, but return separately.
+    types.record_abi_pair(ty, [tag, payload]);
+    ty
+}
+
+// selector 0 chooses the first constructor, 1 the second, and all other
+// selectors the last. The third arm increments the narrowed payload, so the
+// multi-input case must transport distinct values even for the same variant.
+fn phi_graph(
+    mut types: RecordedTypes,
+    enumeration: TyId,
+    word: TyId,
+    payload: TyId,
+    variants: &[u32],
+) -> FunctionGraph {
+    let boolean = types.intern(TypeShape::Bool, Some(SizeAlign { size: 1, align: 1 }));
+    let mut graph = FunctionGraph::new(
+        "register_phi_transport",
+        FunctionAbi {
+            args: vec![PassMode::Direct; 2],
+            ret: PassMode::Pair,
+            c_variadic: false,
+        },
+        types,
+    );
+    graph.level = GraphLevel::Specialized;
+    let start = graph.add_node(
+        Opcode::Start,
+        NodeId::NONE,
+        &[],
+        0,
+        ValueType::Tuple(vec![
+            ValueType::Control,
+            ValueType::Effect,
+            ValueType::Rust(word),
+            ValueType::Rust(word),
+        ]),
+    );
+    graph.start = start;
+    let mut control = graph.add_node(
+        Opcode::Projection,
+        NodeId::NONE,
+        &[start],
+        0,
+        ValueType::Control,
+    );
+    let effect = graph.add_node(
+        Opcode::Projection,
+        NodeId::NONE,
+        &[start],
+        1,
+        ValueType::Effect,
+    );
+    let selector = graph.add_node(
+        Opcode::Projection,
+        NodeId::NONE,
+        &[start],
+        2,
+        ValueType::Rust(word),
+    );
+    let input = graph.add_node(
+        Opcode::Projection,
+        NodeId::NONE,
+        &[start],
+        3,
+        ValueType::Rust(word),
+    );
+    let input = graph.add_node(
+        Opcode::IntCast,
+        NodeId::NONE,
+        &[input],
+        0,
+        ValueType::Rust(payload),
+    );
+    let mut jumps = Vec::new();
+    let mut values = Vec::new();
+    for (index, &variant) in variants.iter().enumerate() {
+        let edge = if index + 1 == variants.len() {
+            control
+        } else {
+            let expected = graph.add_constant(index as u128, word);
+            let condition = graph.add_node(
+                Opcode::Compare,
+                NodeId::NONE,
+                &[selector, expected],
+                ComparePredicate::Equal as u32,
+                ValueType::Rust(boolean),
+            );
+            let branch = graph.add_node(
+                Opcode::If,
+                control,
+                &[condition],
+                0,
+                ValueType::Tuple(vec![ValueType::Control; 2]),
+            );
+            control = graph.add_node(
+                Opcode::Projection,
+                NodeId::NONE,
+                &[branch],
+                1,
+                ValueType::Control,
+            );
+            graph.add_node(
+                Opcode::Projection,
+                NodeId::NONE,
+                &[branch],
+                0,
+                ValueType::Control,
+            )
+        };
+        let fields = if graph.oracle.aggregates[&enumeration].variants[variant as usize].is_empty()
+        {
+            vec![]
+        } else {
+            let value = if index == 2 {
+                let one = graph.add_constant(1, payload);
+                graph.add_node(
+                    Opcode::Add,
+                    NodeId::NONE,
+                    &[input, one],
+                    0,
+                    ValueType::Rust(payload),
+                )
+            } else {
+                input
+            };
+            vec![value]
+        };
+        values.push(graph.add_node(
+            Opcode::MakeVariant,
+            NodeId::NONE,
+            &fields,
+            variant,
+            ValueType::Rust(enumeration),
+        ));
+        jumps.push(graph.add_node(Opcode::Jump, edge, &[], 0, ValueType::Control));
+    }
+    let region = graph.add_node(Opcode::Region, NodeId::NONE, &jumps, 0, ValueType::Control);
+    let mut incoming = vec![region];
+    incoming.extend(values);
+    let value = graph.add_node(
+        Opcode::Phi,
+        NodeId::NONE,
+        &incoming,
+        0,
+        ValueType::Rust(enumeration),
+    );
+    graph.add_node(
+        Opcode::Return,
+        region,
+        &[effect, value],
+        0,
+        ValueType::Control,
+    );
+    verify_graph(&mut graph).unwrap();
+    graph
+}
+
+// Independent expected semantic variant, physical tag, and active payload.
+// None leaves the second ABI lane unspecified, as Option's inactive payload is.
+type Case = (u64, u64, u32, u64, Option<u64>);
+
+fn lower_and_check(mut graph: FunctionGraph, cases: &[Case]) -> (FunctionGraph, LayoutStats) {
+    for &(selector, input, variant, _, payload) in cases {
+        assert_eq!(
+            Interpreter::new(&graph)
+                .run_values(
+                    &[Value::Scalar(selector), Value::Scalar(input)],
+                    &mut |name: &str, _: &[Value]| Err(InterpretError::UnknownCallee(name.into())),
+                )
+                .unwrap(),
+            SemanticOutcome::Return(Value::Variant {
+                variant,
+                fields: payload.into_iter().map(Value::Scalar).collect(),
+            })
+        );
+    }
+    let stats = lower_layout(&mut graph).unwrap();
+    assert_eq!(graph.level, GraphLevel::Layout);
+    verify_graph(&mut graph).unwrap();
+    for &(selector, input, _, tag, payload) in cases {
+        let result = Interpreter::new(&graph)
+            .run(&[selector, input], &mut |name: &str, _: &[u64]| {
+                Err(InterpretError::UnknownCallee(name.into()))
+            })
+            .unwrap();
+        match (result, payload) {
+            (Outcome::ReturnPair(actual_tag, actual_payload), Some(expected)) => {
+                assert_eq!((actual_tag, actual_payload), (tag, expected));
+            }
+            (Outcome::ReturnPair(actual_tag, _), None) => assert_eq!(actual_tag, tag),
+            (result, _) => panic!("expected ScalarPair return, got {result:?}"),
+        }
+    }
+    (graph, stats)
+}
+
+fn assert_scalar_transport(graph: &FunctionGraph, stats: &LayoutStats) {
+    assert_eq!(stats.owned_transport_phis, 0, "{}", graph.dump());
+    assert_eq!(stats.scalar_phis, 2, "tag and payload must remain SSA");
+    // The current L ABI boundary requires one return object. Constructor
+    // snapshots would add one slot per incoming arm and an address Phi.
+    assert_eq!(stats.abi_slots, 1);
+    assert_eq!(graph.stack_slots.len(), 1, "{}", graph.dump());
+    assert!(!graph.ids().any(|node| {
+        graph.op(node) == Opcode::Phi
+            && graph.rust_type(node).is_some_and(|ty| {
+                matches!(graph.oracle.table.shape(ty), TypeShape::PlaceAddress { .. })
+            })
+    }));
+}
+
+#[test]
+fn option_u32_phi_keeps_both_scalar_pair_lanes() {
+    let mut types = RecordedTypes::new();
+    let word = integer(&mut types, IntegerWidth::W64, 8);
+    let small = integer(&mut types, IntegerWidth::W32, 4);
+    let choice = enumeration(
+        &mut types,
+        FieldLayout {
+            ty: small,
+            offset: 0,
+        },
+        FieldLayout {
+            ty: small,
+            offset: 4,
+        },
+        SizeAlign { size: 8, align: 4 },
+        &[0, 1],
+        true,
+    );
+    let (graph, stats) = lower_and_check(
+        phi_graph(types, choice, word, small, &[0, 1]),
+        &[
+            (0, u64::MAX, 0, 0, None),
+            (1, 0, 1, 1, Some(0)),
+            (2, u64::MAX, 1, 1, Some(u32::MAX as u64)),
+            (99, 0x1234_5678_9abc_def0, 1, 1, Some(0x9abc_def0)),
+        ],
+    );
+    assert_scalar_transport(&graph, &stats);
+}
+
+#[test]
+fn padded_small_pair_phi_handles_sparse_tags_and_three_incoming_edges() {
+    let mut types = RecordedTypes::new();
+    let word = integer(&mut types, IntegerWidth::W64, 8);
+    let byte = integer(&mut types, IntegerWidth::W8, 1);
+    let half = integer(&mut types, IntegerWidth::W16, 2);
+    let choice = enumeration(
+        &mut types,
+        FieldLayout {
+            ty: byte,
+            offset: 0,
+        },
+        FieldLayout {
+            ty: half,
+            offset: 2,
+        },
+        SizeAlign { size: 4, align: 2 },
+        &[3, 17],
+        true,
+    );
+    let (graph, stats) = lower_and_check(
+        phi_graph(types, choice, word, half, &[0, 1, 1]),
+        &[
+            (0, u64::MAX, 0, 3, None),
+            (1, u64::MAX, 1, 17, Some(0xffff)),
+            (2, u64::MAX, 1, 17, Some(0)),
+            (7, 0x1234_5678, 1, 17, Some(0x5679)),
+        ],
+    );
+    assert_scalar_transport(&graph, &stats);
+}
+
+#[test]
+fn many_payload_alternatives_still_use_owned_transport() {
+    let mut types = RecordedTypes::new();
+    let word = integer(&mut types, IntegerWidth::W64, 8);
+    let choice = enumeration(
+        &mut types,
+        FieldLayout {
+            ty: word,
+            offset: 0,
+        },
+        FieldLayout {
+            ty: word,
+            offset: 8,
+        },
+        SizeAlign { size: 16, align: 8 },
+        &[2, 5, 9, 14, 20, 27, 35, 44],
+        false,
+    );
+    // Nine logical leaves still exceed the two physical ABI lanes. Correcting
+    // the small-pair cost must preserve the storage choice for this enum.
+    let (graph, stats) = lower_and_check(
+        phi_graph(types, choice, word, word, &[0, 3, 7]),
+        &[
+            (0, 0, 0, 2, Some(0)),
+            (1, 0x1234_5678_9abc_def0, 3, 14, Some(0x1234_5678_9abc_def0)),
+            (2, u64::MAX, 7, 44, Some(0)),
+            (9, 700, 7, 44, Some(701)),
+        ],
+    );
+    assert_eq!(stats.owned_transport_phis, 1, "{}", graph.dump());
+    assert_eq!(stats.abi_slots, 0, "return consumes the selected snapshot");
+    assert!(!graph.stack_slots.is_empty());
+}
